#!/usr/bin/env bash
# with-exaone-key CMD [ARGS…] — run ONE command with EXAONE_API_KEY exported
# (exaone lane). The key never enters the calling shell.
#
#   tools/api_batch/bin/with-exaone-key uv run --no-sync --with pyyaml \
#       python -m tools.api_batch.cli exaone probe
#
# Refuses `claude*` (never hand a third-party key to an agent session) and
# env/printenv/set/export/declare, which would print the key. Warns when the key
# is >= 25 days old; keys expire 30 days after issue.
set -euo pipefail
DIR=${EXAONE_API_ENV_DIR:-$HOME/.config/exaone-api}
FILE=$DIR/env
(( $# )) || { echo "usage: with-exaone-key CMD [ARGS…]" >&2; exit 2; }
[[ -r $FILE ]] || { echo "missing: $FILE — 별도 터미널에서 tools/api_batch/bin/exaone-key-set 실행" >&2; exit 1; }
case $(basename -- "$1") in
  claude*) echo "refuse: claude 세션에는 EXAONE key를 주입하지 않는다" >&2; exit 2 ;;
  env|printenv|set|export|declare) echo "refuse: $1 은 key를 출력한다" >&2; exit 2 ;;
esac
if [[ -r $DIR/issued ]]; then
  issued=$(<"$DIR/issued")
  if t=$(date -d "$issued" +%s 2>/dev/null); then
    age=$(( ( $(date +%s) - t ) / 86400 ))
    if (( age >= 30 )); then
      echo "error-hint: EXAONE key가 발급 ${age}일째 — 발급 30일 후 만료된다. 새 key를 받아 exaone-key-set으로 다시 저장하라" >&2
    elif (( age >= 25 )); then
      echo "warning: EXAONE key가 발급 ${age}일째 — $(( 30 - age ))일 안에 만료된다" >&2
    fi
  fi
else
  echo "warning: $DIR/issued 없음 — key 나이를 확인할 수 없다 (발급 30일 후 만료)" >&2
fi
set -a; . "$FILE"; set +a
exec "$@"
